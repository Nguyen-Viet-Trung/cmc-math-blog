{
  "name": "cmc-math-blog",
  "version": "0.1.0",
  "description": "CMA MATHS CLUB blog (CMC) — Diễn đàn thảo luận Toán học, gõ công thức LaTeX, chia sẻ lời giải hay và tích điểm đổi quà.",
  "private": true,
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  },
  "scripts": {
    "postinstall": "prisma generate",
    "sync-env": "node scripts/sync-env.mjs",
    "setup": "node scripts/sync-env.mjs && node scripts/setup-supabase.mjs",
    "db:pull": "node scripts/sync-env.mjs && prisma db pull && prisma generate",
    "db:studio": "node scripts/sync-env.mjs && prisma studio",
    "predev": "node scripts/sync-env.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/sync-env.mjs && prisma generate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.40.0",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "next": "^15.2.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
